# Required: Your WordPress site base URL (without trailing slash)
WP_SITE_URL=https://example.com

# Authentication Method 1: WordPress Application Password (Recommended for self-hosted & WP.com Business)
# Generate at: WP Admin -> Users -> Profile -> Application Passwords
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Authentication Method 2: WordPress.com / JWT Bearer Token (Optional alternative)
# WP_BEARER_TOKEN=your_oauth_or_jwt_token
